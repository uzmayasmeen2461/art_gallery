# Public business contact only: country code + number, digits only. Leave blank for demo.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Set only to your actual deployment URL before launch (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo defaults to noindex. Set true only after launch checklist in README.
NEXT_PUBLIC_ALLOW_INDEXING=false
